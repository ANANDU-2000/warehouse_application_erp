# Server
PORT=3000
NODE_ENV=development

# SQL Server (wired in Phase 3.2 — placeholders only)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=WarehouseErp
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
# Windows local without TCP: leave unset (defaults msnodesqlv8 + ODBC Driver 18).
# SQLSERVER_DRIVER=msnodesqlv8
# SQLSERVER_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Use tedious when SQL Server TCP/IP is enabled on port 1433:
# SQLSERVER_DRIVER=tedious

# JWT (Phase 3.5 — mirrors FastAPI jwt_secret / jwt_refresh_secret / TTLs)
# Dev defaults allow change-me strings; production must use secrets >= 32 chars (no change-me).
JWT_SECRET=change-me-min-32-chars-dev-only
JWT_REFRESH_SECRET=change-me-min-32-chars-refresh-dev
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Logging (Phase 3.9) — debug | info | warn | error
LOG_LEVEL=info
