# Server
PORT=3000
NODE_ENV=development

# SQL Server (wired in Phase 3.2 — placeholders only)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=WarehouseErp
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# JWT (Phase 3.5 — mirrors FastAPI jwt_secret / jwt_refresh_secret / TTLs)
# Dev defaults allow change-me strings; production must use secrets >= 32 chars (no change-me).
JWT_SECRET=change-me-min-32-chars-dev-only
JWT_REFRESH_SECRET=change-me-min-32-chars-refresh-dev
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
